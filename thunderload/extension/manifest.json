{
  "manifest_version": 3,
  "name": "ThunderLoad Download Manager",
  "short_name": "ThunderLoad",
  "version": "0.2.0",
  "description": "A quiet, lightweight download companion with automatic media detection and optional desktop acceleration.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "downloads", "contextMenus", "webRequest"],
  "optional_permissions": ["nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Scan page with ThunderLoad",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "scan-media": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Scan the current tab for downloadable media"
    }
  }
}
